# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY

# AI: Claude on Amazon Bedrock via the Converse API. Leave the keys empty to disable AI features.
# IAM user with AmazonBedrockFullAccess (needs bedrock:InvokeModel).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Inference profile ID (or its full ARN).
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Optional: a different model just for reading documents.
BEDROCK_EXTRACTION_MODEL_ID=
# Optional: a faster model for quick tasks (name conversion, anonymising). Remove to use the main model.
BEDROCK_FAST_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# AI usage limits (0 = no limit): requests per user per minute, and per firm per 24 hours.
AI_LIMIT_PER_MINUTE=20
AI_LIMIT_PER_DAY=500

# Shown on the public policy pages (Terms, Privacy, DPDP, Grievance, Contact).
# Fill these before launch; empty values show "[to be added]" on the pages.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ADDRESS=Ajmer, Rajasthan, India
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_GRIEVANCE_EMAIL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY

# AI via OpenRouter (https://openrouter.ai/keys). Leave empty to disable AI features.
OPENROUTER_API_KEY=
# Any OpenRouter model id. The default reads PDFs, scans and Hindi well.
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional: a different (e.g. stronger vision) model just for document extraction.
OPENROUTER_EXTRACTION_MODEL=
# Optional: comma-separated backup models tried when the main one is rate-limited (429) or down.
# Keep at least one paid (non ":free") model here, e.g. openai/gpt-4.1-mini,anthropic/claude-haiku-4.5
OPENROUTER_FALLBACK_MODELS=
# Optional: how OpenRouter parses PDFs sent for OCR: native | mistral-ocr | pdf-text.
# mistral-ocr is best for scanned / photographed Hindi papers (small per-page cost);
# pdf-text is free but only works for PDFs that already have a text layer.
OPENROUTER_PDF_ENGINE=
# Shown to OpenRouter as the calling app.
OPENROUTER_SITE_URL=http://localhost:3000
